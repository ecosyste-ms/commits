{
  "cron": [
    {
      "command": "bundle exec rake hosts:update_counts",
      "schedule": "*/15 * * * *"
    },
    {
      "command": "bundle exec rake repositories:sync_least_recent",
      "schedule": "*/10 * * * *"
    },
    {
      "command": "bundle exec rake repositories:sync_invisible",
      "schedule": "0 * * * *"
    },
    {
      "command": "bundle exec rake hosts:sync_all",
      "schedule": "0 0 * * *"
    },
    {
      "command": "bundle exec rake owners:update_counts",
      "schedule": "30 2 * * *"
    },
    {
      "command": "bundle exec rake sidekiq:unique_jobs:clear",
      "schedule": "0 0 * * 0"
    }
  ]
}
